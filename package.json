{
  "name": "e-pharmacy-backend",
  "version": "1.0.0",
  "private": true,
  "description": "E-Pharmacy administration API",
  "type": "module",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch --import tsx src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:source": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run --config vitest.source.config.ts",
    "seed": "node --env-file-if-exists=.env --import tsx src/scripts/seed.ts",
    "seed:demo": "node --env-file-if-exists=.env --import tsx src/scripts/seed-demo.ts",
    "demo:generate": "node scripts/generate-demo.mjs",
    "user:init": "node --env-file-if-exists=.env --import tsx src/scripts/init-user.ts",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "docs": "tsx src/scripts/openapi.ts"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.17",
    "mongoose": "^9.12.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.14.0",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "minimatch": "11.0.1"
  }
}
